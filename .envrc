source_env_if_exists .envrc.local

export DIRENV_WARN_TIMEOUT=20s

if has devenv; then
    eval "$(devenv direnvrc)"
    use devenv
fi

# Redis Cloud API credentials belong in .envrc.local.
# See .envrc.example. This file keeps the URL default only.
export REDISCLOUD_URL="https://api.redislabs.com/v1"

# These two variables belong to scripts/test-provider.sh.
# make local-deploy and make e2e use upbound-system from the Makefile.
export CROSSPLANE_NAMESPACE="crossplane-system"
export PROVIDER_NAMESPACE="crossplane-system"

# Development Settings
export DOCKER_HOST="unix:///run/user/$(id -u)/podman/podman.sock"
export KIND_CLUSTER_NAME="rediscloud-test"
export KIND_EXPERIMENTAL_PROVIDER=podman
export KUBECONFIG_PATH="${PWD}/.kube/config"
